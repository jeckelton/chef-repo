apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  failurePolicy: reinstall
  valuesContent: |-
    kubeProxyReplacement: true

    k8sServiceHost: "localhost"
    k8sServicePort: "6443"

    l2announcements:
      enabled: true

    k8sClientRateLimit:
      qps: 20
      burst: 40

    hubble:
      enabled: <%= @hubble_enabled %>
      relay:
        enabled: <%= @relay_enabled %>
      ui:
        enabled: <%= @ui_enabled %>
